# Oni server configuration (Req 16). See design.md "Configuration (Req 16)".
#
# Copy this file to .env (gitignored) for local runs.
# NEVER commit real values. This file holds safe placeholders only.
# Keys marked SECRET below must never be committed. In production set them only in the
# Render dashboard (sync: false), except SESSION_SECRET, which Render generates.
# There is no database, so there is no DATABASE_URL.
# Empty values count as unset and select the default.
# TERMINAL_TOKEN is not a server setting: only the MCP process reads it.

# HTTP and WebSocket port. Render sets this. Default: 8080
PORT=8080

# Path to the engine binary. Default: rust/target/release/engine (".exe" added on Windows)
ENGINE_PATH=

# Market data source: replay | live. Default: replay (no API keys needed)
DATA_MODE=replay

# Fixture file in fixtures/ used in replay mode. Must match ^[a-z0-9-]+\.jsonl$. Default: demo.jsonl
REPLAY_FIXTURE=demo.jsonl

# Replay speed sent with StartReplay: an integer from 1 to 50. 50 plays the 2 h demo fixture
# in about 2.5 minutes. Default: 1 (real time)
REPLAY_SPEED=1

# Comma-separated browser origins allowed to open /ws. Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Origin of the web UI, used to build the TUI pair URL <WEB_URL>/pair?code=... (Req 16.9).
# Must be listed in ALLOWED_ORIGINS, otherwise the server exits with code 1.
# Default: the first ALLOWED_ORIGINS entry
WEB_URL=

# Single-venue alias for LIVE_VENUES (for example: coinbase). Used only when DATA_MODE=live.
# Leave empty to use LIVE_VENUES.
LIVE_VENUE=

# SECRET. HMAC key for Session_Tokens (Req 16.7, 16.8). At least 32 bytes. Generate one, for example:
#   openssl rand -base64 48
# Required when NODE_ENV=production (on Render the Blueprint generates it).
# Unset outside production: a random per-process secret is used, so sessions end on restart.
SESSION_SECRET=

# true rejects every new order. Default: false
KILL_SWITCH=false

# SECRET. Enables plain-English orders. Leave empty to disable them.
OPENAI_API_KEY=

# OpenAI model for plain-English orders (Responses API, structured outputs).
# Leave empty to use the default, gpt-5.4-mini.
OPENAI_MODEL=

# Comma list of live feeds: coinbase,backpack,jupiter,raydium. Used only when DATA_MODE=live. Default: all four
LIVE_VENUES=

# SECRET. Optional Jupiter Price API key (x-api-key header). Raises the data rate limit. Prices only.
JUPITER_API_KEY=

# Starting paper balance in USD, integer 1000 to 100000000. Default: 100000
STARTING_BALANCE=

# Default AI provider: ollama | openai | anthropic | nvidia. Default: first available in that order
LLM_PROVIDER=

# SECRET. Anthropic (Claude) API key. Leave empty to disable the provider.
ANTHROPIC_API_KEY=

# Anthropic model override. Empty uses the built-in default.
ANTHROPIC_MODEL=

# SECRET. NVIDIA NIM API key. Leave empty to disable the provider.
NVIDIA_API_KEY=

# NVIDIA NIM model override. Empty uses the built-in default.
NVIDIA_MODEL=

# SECRET (a URL can carry credentials). NVIDIA NIM base URL. Empty uses the default.
NVIDIA_BASE_URL=

# SECRET (treated like a credential). Ollama base URL. Default: http://127.0.0.1:11434 (use 127.0.0.1, not localhost, on Windows)
OLLAMA_BASE_URL=

# Default Ollama model. Default: gemma4 (run: ollama pull gemma4). Oni lists every installed
# model; you can pick another one in the web Copilot panel, Settings page, or with M in the TUI.
OLLAMA_MODEL=

# AI requests allowed per connection per minute. Default: 6
AI_RATE_PER_MIN=

# AI provider calls per UTC day for OpenAI, Anthropic, and NVIDIA. Default: 500
AI_DAILY_CAP=

# News source: newsapi | cryptopanic | none. Default: by NODE_ENV and available key
NEWS_PROVIDER=

# SECRET. NewsAPI key (local development only).
NEWS_API_KEY=

# SECRET. CryptoPanic auth token (hosted).
CRYPTOPANIC_API_KEY=

# CryptoPanic plan: developer | growth | enterprise. Default: developer
CRYPTOPANIC_PLAN=

# News cache time in seconds. Empty uses the default.
NEWS_TTL_SECONDS=

# true allows NewsAPI when NODE_ENV=production (its terms may forbid it). Default: false
NEWS_ALLOW_NEWSAPI_IN_PRODUCTION=

# development | production | test. production requires SESSION_SECRET.
NODE_ENV=
