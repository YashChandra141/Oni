# Haunted Terminal server configuration (Req 16). See design.md "Configuration (Req 16)".
#
# Copy this file to .env (gitignored) for local runs.
# NEVER commit real values. This file holds safe placeholders only.
# DATABASE_URL, DIRECT_URL, OPENAI_API_KEY, and SESSION_SECRET are secrets (the
# whole URLs, not just their passwords). In production set them only in the Render
# dashboard (sync: false), except SESSION_SECRET, which Render generates.
# Empty values count as unset and select the default.
# TERMINAL_TOKEN is not a server setting: only the MCP process reads it.

# HTTP and WebSocket port. Render sets this. Default: 8080
PORT=8080

# Path to the engine binary. Default: rust/target/release/engine (".exe" added on Windows)
ENGINE_PATH=

# Market data source: replay | live. Default: replay (no API keys needed)
DATA_MODE=replay

# Fixture file in fixtures/ used in replay mode. Must match ^[a-z0-9-]+\.jsonl$. Default: demo.jsonl
REPLAY_FIXTURE=demo.jsonl

# Replay speed sent with StartReplay: an integer from 1 to 50. 50 plays the 2 h demo fixture
# in about 2.5 minutes. Default: 1 (real time)
REPLAY_SPEED=1

# Comma-separated browser origins allowed to open /ws. Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Origin of the web UI, used to build the TUI pair URL <WEB_URL>/pair?code=... (Req 16.9).
# Must be listed in ALLOWED_ORIGINS, otherwise the server exits with code 1.
# Default: the first ALLOWED_ORIGINS entry
WEB_URL=

# Live market data venue: coinbase | backpack. Used only when DATA_MODE=live. Default: backpack
LIVE_VENUE=

# SECRET. HMAC key for Session_Tokens (Req 16.7, 16.8). At least 32 bytes. Generate one, for example:
#   openssl rand -base64 48
# Required when NODE_ENV=production (on Render the Blueprint generates it).
# Unset outside production: a random per-process secret is used, so sessions end on restart.
SESSION_SECRET=

# true rejects every new order. Default: false
KILL_SWITCH=false

# SECRET. Neon pooled connection string, used by the Prisma Client at runtime.
# Format: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Unset outside production: the journal is kept in memory only. Required when NODE_ENV=production.
DATABASE_URL=

# SECRET. Neon direct (non-pooled) connection string, used only by Prisma Migrate.
# Format: postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
# Required when NODE_ENV=production.
DIRECT_URL=

# pg forces @prisma/adapter-pg (plain Postgres, e.g. local Docker or CI).
# Leave empty to choose the adapter from the DATABASE_URL host.
DB_ADAPTER=

# SECRET. Enables plain-English orders. Leave empty to disable them.
OPENAI_API_KEY=

# OpenAI model for plain-English orders. The default is set in Task 13.
OPENAI_MODEL=

# development | production | test. production requires DATABASE_URL, DIRECT_URL, and SESSION_SECRET.
NODE_ENV=
